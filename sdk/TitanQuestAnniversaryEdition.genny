type int 4 [[i32]]
type int32_t 4 [[i32]]
type size_t 4 [[i32]]
type uint8_t 1 [[u8]]
type uint32_t 4 [[u32]]
type uint64_t 8 [[u64]]
type int64_t 8 [[i64]]
type float 4 [[f32]]
type void 0
type char 1
type bool 1 [[u8]]

namespace GAME {

struct World {
    bool debugEnabled @ 0x8;
    char* fileName @ 0x10 [[utf8*]];
}

struct IntVec3 {
    int x;
    int y;
    int z;
}

struct Vec2 {
    float x;
    float y;
}

struct Vec3 {
    float x;
    float y;
    float z;
}

struct CharacterBio {
     float currentLife @ 0x1c;
     float maxLife @ 0x60;

     float currentMana @ 0x30;
     float maxMana @ 100;
}

struct Viewport {
    int x;
    int y;
    int w;
    int h;
}

struct ABBox {
    float 	xmin
    float 	xmax
    float 	ymin
    float 	ymax
    float 	zmin
    float 	zmax
}

struct Region {
    World* world @ 0x24;
    IntVec3 worldOffset @ 0x2c;
    char* name @ 0x38 [[utf8*]];
}

struct WorldVec3 {
    Region* region;
    Vec3 position;
}

struct Coords {
    Vec3 right;
    Vec3 up;
    Vec3 forward;
}

struct WorldCoords {
    WorldVec3 location;
}

struct WorldFrustum {}



 enum class LifeState : uint32_t {
    Unknown = 0,
    Initializing = 1,
    Alive = 2,
    Dying = 3,
    Dead = 4,
    Respawning = 5
}

struct PhysicsMesh {
    ABBox boundingBox @ 0x1c;
}

struct Resource {
    char* fileName @ 0xc [[utf8*]];
    uint32_t lastFrameUsed @ 0x38;
    //PhysicsMesh* physicsMesh @ 0xf8;
}

struct GraphicsMesh : Resource {
    int meshId @ 0x8;
    Vec3 centerOfMass @ 0xC8;
    uint32_t numHitboxes @ 0xa0;
    //ABBox* boundingBox @ 200;
    uint32_t numFaces @ 0x74;
    uint32_t numVertices @ 0x6c;
    uint32_t numBones @ 0xa8;
}

struct SkeletalPose {
    void* boneArrayPtr;
    uint32_t padding_or_count;
}

struct Color {
    float r;
    float g;
    float b;
    float a;
}

struct GraphicsMeshInstance {
    SkeletalPose* pose @ 0x128;
    GraphicsMesh* graphicsMesh @ 0x4;
    Vec3* scale @ 0x140;
    //ABBox* regionSpaceABBox @ 0x1a0;
    float somethingX @ 0x16c;
    float somethingY @ 0x164;

    bool isDissolvingOne @ 0x228;
    bool isDissolvingTwo @ 0x250;

    Color diffuseColor @ 0x1c8;
    float highlight @ 0x1d8;
    Color color @ 0x1dc;
}

struct Object {
    char* objectName @ 0x04 [[utf8*]];
    uint32_t objectId @ 0x20;
}

struct GameString {
    char inlineBuffer[16] @ 0x0;
    uint32_t size @ 0x10;
    uint32_t capacity @ 0x14;
}

struct Entity : Object {
    GameString descriptionTag @ 0x258;
    GraphicsMeshInstance* graphicsMeshInstance @ 0x184;
    float height @ 0x1e4;
    WorldCoords coords @ 0xa0;
    int32_t lastFrameUpdated @ 0x140;
    Color tintColor @ 0x274;
    Color highlightColor @ 0x284;
    bool highlightEnabled @ 0x294;
}

struct UniqueId {
    uint64_t id @ 0x0;
}

enum TeamMajor : uint32_t
{
    TeamMajor_Friendly = 0,
    TeamMajor_Hostile  = 1,
    TeamMajor_Human    = 2,
    TeamMajor_Monster  = 3,
};

enum TeamMinor : uint32_t
{
    TeamMinor_Friendly = 0,

    // value 1 is special/hostile-ish in IsFoe for major == 3
    TeamMinor_Hostile  = 1,

    TeamMinor_Red      = 2,
    TeamMinor_Orange   = 3,
    TeamMinor_Yellow   = 4,
    TeamMinor_Green    = 5,
    TeamMinor_Blue     = 6,
    TeamMinor_Indigo   = 7,
    TeamMinor_Violet   = 8,
};

struct Team {
    TeamMajor major;
    TeamMinor minor;
    bool initialized;
}

struct CombatManager {
    uint32_t attackerId @ 0xc4;
    int32_t lastAttackTime @ 0xc0;
    uint32_t combatState @ 0xb4;
    int32_t combatIdleTime @ 0xbc;
}

enum Weapon_Type : uint32_t 
{
    None = 0,     
}

struct SkillManager {
  bool isRangedWeapon @ 0x120;
  Weapon_Type left @ 0x118;
  Weapon_Type right @ 0x11c;
  bool hideSkillsFromUi @ 0x190;
}

struct Inventory {
    void* vft;
}

struct Character : Entity {
    char* record @ 0x4 [[utf8*]];
    float currentLife @ 0x860;
    float maxLife @ 0x8a4;
    LifeState lifeState @ 0x1134
    char* type @ 0xc20 [[utf8*]];
    CharacterBio bio @ 0x844;
    bool isInvisible @ 0xD50;
    bool invincible @ 0xd64;
    bool god @ 0xd65;
    bool omnipotent @ 0xd66;
    bool fastcasting @ 0xd6c;
    bool observerCheatMode @ 0x113c;
    bool observerMode @ 0x113d;
    uint32_t attackerId @ 0x38c;
    uint32_t level @ 0xc5c;
    uint32_t money @ 0xc14;
    UniqueId* uniqueid @ 0x6c;
    Team team @ 0xD44;

    char* portraitName @ 0x1e84 [[utf8*]];

    CombatManager combatManager @ 0x2c8;
    SkillManager skillManager @ 0x568; 

    Inventory inventory @ 0x7a0;

    uint32_t experience @ 0xc60;
    uint32_t modifierPoints @ 0xc64;
    uint32_t skillPoints @ 0xc68;

    bool showAngerLevels @ 0x1201;
}

struct PlayerGameInterface {
    void* vft;
}

struct Player : Character {
    uint32_t currentLevel @ 0xc5c;
    PlayerGameInterface* gameInterface @ 0x1f18;
    uint32_t gold @ 0x40;
    GameString name @ 0x1f30;
}

struct Npc : Character {

}


enum class MonsterClassification : uint32_t {
   Normal = 0,
   Champion = 1,
   Hero = 2,
   Boss = 3,
   Quest = 4,
}

struct Monster : Character {
    MonsterClassification classification @ 0x1FB8;
    bool givesXp @ 0x2294;
    uint32_t baseExperience @ 0xC60;
    bool showStatusWidget @ 0x2229;
}

struct GameInfo {
    char* name @ 0x10 [[utf8*]];
    char* levelName @ 0x38 [[utf8*]];
    uint32_t difficulty @ 0x124;
    int32_t elapsedGameTime @ 0x14c;
    int32_t gameSpeed @ 0x144;
    uint32_t gameStartTime @ 0x148;
    uint32_t playerLevel @ 0x11C;
    uint32_t levelRange @ 0x120;
}

struct Mat4 {
    float m[4][4];
}

struct Camera {
    void* vft;
    Coords coords;
    Vec3 position;
    float nearPlane @ 0x40;
    float farPlane @ 0x44;
}

struct SystemTimer {
    int timer1;
    int timer2;
    int timer3;
}

struct WorldCamera {
    float distanceDefault @ 0x4;
    float pitchDefault @ 0x8;
    float yaw @ 0x10;
    float pitch @ 0x14;
    float fov @ 0x18;
    float nearPlane @ 0x20;
    float distance @ 0xc;
    float farPlane @ 0x1c;
    Vec3 offset @ 0x64;

    Camera camera @ 0x70;
}

struct GameCamera : WorldCamera {
    Player* player @ 0x108;
    WorldVec3 target @ 0x10c;
}

struct RenderDevice {}

struct GraphicsCanvas {
    RenderDevice* renderDevice @ 0x1c;
}

struct Display {
    void* vft;
}

struct GraphicsEngine {
    GraphicsCanvas* graphicsCanvas @ 0x58;
    RenderDevice* renderDevice @ 0x34;
    int width @ 0x38;
    int height @ 0x3c; 
    Display display @ 0x5c;
    bool enableShadows @ 0xcb;
    bool enableBoundingBoxes @ 0xc5;
    bool enableWireframe @ 0xc7;
    bool enableLighting @ 0xcc;
    bool enableWater @ 0xd6;
    bool enableGridTiles @ 0xd2;
    bool enableFrameRateDisplay @ 0xca;
}

